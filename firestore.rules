rules_version = '2';

// Regole di La Taverna dei Giochi. Si incollano in Console Firebase → Firestore Database → Regole → Pubblica.
// Spiegazione e limiti: docs/FIREBASE-PIANO.md. Protezione leggera pensata per un gruppo di amici, non anti-truffa.
service cloud.firestore {
  match /databases/{database}/documents {

    function accesso() { return request.auth != null; }
    function nomeOk(d) { return d.name is string && d.name.size() >= 1 && d.name.size() <= 24; }

    // acquisto di UN oggetto al prezzo indicato: compare una sola chiave in `owned`, vale true, e le monete scendono del prezzo
    function acquisto(id, prezzo) {
      let o = request.resource.data.owned.diff(resource.data.owned);
      return o.addedKeys().hasAll([id]) && o.affectedKeys().hasOnly([id])
        && request.resource.data.owned[id] == true
        && request.resource.data.coins == resource.data.coins - prezzo;
    }

    // valutazione ELO di un gioco: cambia solo quella chiave, resta tra 100 e 3000 e si sposta al massimo di 32 punti (ELO.K)
    function elo(g) {
      let a = resource.data.get('elo', {});
      let b = request.resource.data.get('elo', {});
      return b.diff(a).affectedKeys().hasOnly([g])
        && b[g] >= 100 && b[g] <= 3000
        && b[g] - a.get(g, 1000) <= 32 && a.get(g, 1000) - b[g] <= 32;
    }
    function eloUguale() { return request.resource.data.get('elo', {}) == resource.data.get('elo', {}); }

    // eroi delle campagne: privati del proprietario, al massimo cinque (e1..e5). Razza, classe, punteggi base e data non cambiano più.
    // Razze e classi tra i segnaposto sono generate dal catalogo (npm run regole).
    function costoPunteggio(v) { return v <= 13 ? v - 8 : (v == 14 ? 7 : 9); }
    function baseEroeOk(b) {
      return b.keys().hasOnly(['for', 'des', 'cos', 'int', 'sag', 'car'])
        && b['for'] is int && b['des'] is int && b['cos'] is int && b['int'] is int && b['sag'] is int && b['car'] is int
        && b['for'] >= 8 && b['for'] <= 15 && b['des'] >= 8 && b['des'] <= 15 && b['cos'] >= 8 && b['cos'] <= 15
        && b['int'] >= 8 && b['int'] <= 15 && b['sag'] >= 8 && b['sag'] <= 15 && b['car'] >= 8 && b['car'] <= 15
        && costoPunteggio(b['for']) + costoPunteggio(b['des']) + costoPunteggio(b['cos']) + costoPunteggio(b['int']) + costoPunteggio(b['sag']) + costoPunteggio(b['car']) <= 27;
    }
    function aspettoEroeOk(a) {
      return a.keys().hasOnly(['pelle', 'capelli', 'mantello', 'viso'])
        && a.pelle is int && a.pelle >= 0 && a.pelle < 6 && a.capelli is int && a.capelli >= 0 && a.capelli < 7
        && a.mantello is int && a.mantello >= 0 && a.mantello < 6 && a.viso is int && a.viso >= 0 && a.viso < 4;
    }
    function razzaEroeOk(r) {
      return
        // eroi:razze
        r == 'umano'
        || r == 'elfo'
        || r == 'nano'
        || r == 'piccolo'
        || r == 'orco'
        // eroi:razze:fine
        ;
    }
    function classeEroeOk(c) {
      return
        // eroi:classi
        c == 'guerriero'
        || c == 'ladro'
        || c == 'mago'
        || c == 'chierico'
        || c == 'esploratore'
        || c == 'bardo'
        // eroi:classi:fine
        ;
    }
    // Oggetti dell'avventura: gli id validi sono generati dal catalogo (npm run regole). Le regole controllano id, posti e misure;
    // il livello minimo e le armi a due mani li controlla il client (EROI.coerente). Non c'è modo di provare da dove arrivi un oggetto.
    function armiEroe() {
      return [
        // oggetti:armi
        'pugnali',
        'bastone',
        'mazza',
        'spada-lunga',
        'stocco',
        'arco',
        'ascia',
        'lancia',
        'fionda',
        'spada-corta',
        'martello-guerra',
        'balestra',
        'spadone',
        'grande-ascia',
        'maglio',
        'picca',
        'arco-lungo',
        'spada-argentata',
        'stocco-lampo',
        'pugnali-notturni',
        'mazza-sacra',
        'arco-del-cacciatore',
        'bastone-arcano',
        'lama-della-brace',
        'arco-del-vento',
        'bastone-del-gelo',
        'maglio-del-crollo',
        'spada-dei-re',
        'arco-stellato'
        // oggetti:armi:fine
      ];
    }
    function armatureEroe() {
      return [
        // oggetti:armature
        'stracci',
        'cuoio',
        'cuoio-borchiato',
        'camicia-maglia',
        'scaglie',
        'cotta-maglia',
        'corazza-piastre',
        'cuoio-della-notte',
        'mezza-corazza',
        'maglia-argentea',
        'armatura-completa',
        'corazza-del-guardiano',
        'armatura-del-sovrano'
        // oggetti:armature:fine
      ];
    }
    function scudiEroe() {
      return [
        // oggetti:scudi
        'scudo-piccolo',
        'scudo-legno',
        'scudo-torre',
        'scudo-del-custode',
        'scudo-specchio',
        'scudo-del-re'
        // oggetti:scudi:fine
      ];
    }
    function accessoriEroe() {
      return [
        // oggetti:accessori
        'amuleto-di-quercia',
        'guanti-da-lavoro',
        'fascia-da-cacciatore',
        'anello-di-rame',
        'anello-protettivo',
        'stivali-leggeri',
        'guanti-del-ladro',
        'mantello-ombroso',
        'amuleto-vitale',
        'anello-del-tiro',
        'anello-della-forza',
        'anello-del-custode',
        'amuleto-della-fenice',
        'mantello-fiammeo',
        'cintura-del-gigante',
        'cuore-di-drago',
        'occhio-del-falco'
        // oggetti:accessori:fine
      ];
    }
    function consumabiliEroe() {
      return [
        // oggetti:consumabili
        'razione',
        'kit-guaritore',
        'pozione-cura',
        'antidoto',
        'bomba-fuoco',
        'pozione-cura-maggiore',
        'bomba-gelo',
        'pergamena-fulmine',
        'pergamena-benedizione',
        'tonico-concentrazione',
        'pozione-cura-suprema',
        'elisir-vigore'
        // oggetti:consumabili:fine
      ];
    }
    function oggettiEroe() {
      return [
        // oggetti:tutti
        'pugnali',
        'bastone',
        'mazza',
        'spada-lunga',
        'stocco',
        'arco',
        'ascia',
        'lancia',
        'fionda',
        'spada-corta',
        'martello-guerra',
        'balestra',
        'spadone',
        'grande-ascia',
        'maglio',
        'picca',
        'arco-lungo',
        'spada-argentata',
        'stocco-lampo',
        'pugnali-notturni',
        'mazza-sacra',
        'arco-del-cacciatore',
        'bastone-arcano',
        'lama-della-brace',
        'arco-del-vento',
        'bastone-del-gelo',
        'maglio-del-crollo',
        'spada-dei-re',
        'arco-stellato',
        'stracci',
        'cuoio',
        'cuoio-borchiato',
        'camicia-maglia',
        'scaglie',
        'cotta-maglia',
        'corazza-piastre',
        'cuoio-della-notte',
        'mezza-corazza',
        'maglia-argentea',
        'armatura-completa',
        'corazza-del-guardiano',
        'armatura-del-sovrano',
        'scudo-piccolo',
        'scudo-legno',
        'scudo-torre',
        'scudo-del-custode',
        'scudo-specchio',
        'scudo-del-re',
        'amuleto-di-quercia',
        'guanti-da-lavoro',
        'fascia-da-cacciatore',
        'anello-di-rame',
        'anello-protettivo',
        'stivali-leggeri',
        'guanti-del-ladro',
        'mantello-ombroso',
        'amuleto-vitale',
        'anello-del-tiro',
        'anello-della-forza',
        'anello-del-custode',
        'amuleto-della-fenice',
        'mantello-fiammeo',
        'cintura-del-gigante',
        'cuore-di-drago',
        'occhio-del-falco',
        'razione',
        'kit-guaritore',
        'pozione-cura',
        'antidoto',
        'bomba-fuoco',
        'pozione-cura-maggiore',
        'bomba-gelo',
        'pergamena-fulmine',
        'pergamena-benedizione',
        'tonico-concentrazione',
        'pozione-cura-suprema',
        'elisir-vigore',
        'sigillo-dei-corvi',
        'chiave-dell-antro',
        'frammento-di-corona'
        // oggetti:tutti:fine
      ];
    }
    // Scelte di poteri e talenti (livelli 2..10, chiave = livello): gli id validi sono generati da APOT (npm run regole).
    // Le regole controllano che l'id esista per quel livello e che il livello sia raggiunto; quale dei due proposti sia stato offerto lo controlla il client (EROI.coerente).
    function talentiEroe() {
      return [
        // scelte:talenti
        'occhio-vigile',
        'piede-svelto',
        'guardia-alta',
        'mano-ferma',
        'colpo-pesante',
        'pelle-dura',
        'mente-lucida',
        'fibra-forte',
        'mani-guaritrici',
        'sangue-freddo',
        'pelle-di-brace',
        'fede-salda',
        'colpo-basso',
        'tiro-teso',
        'riserva-di-forze',
        'rialzo-rapido',
        'spirito-indomito',
        'passo-d-ombra',
        'mano-lesta',
        'sguardo-gelido'
        // scelte:talenti:fine
      ];
    }
    function poteriEroe3() {
      return [
        // scelte:poteri3
        'parata',
        'fendente-rapido',
        'colpo-ai-garretti',
        'finta-e-sparisci',
        'sfera-di-fiamme',
        'raggio-di-gelo',
        'benedizione',
        'colpo-radioso',
        'pioggia-di-frecce',
        'passo-nel-bosco',
        'canzone-che-guarisce',
        'colpo-di-scena'
        // scelte:poteri3:fine
      ];
    }
    function poteriEroe5() {
      return [
        // scelte:poteri5
        'urto-di-scudo',
        'grido-di-guerra',
        'danza-di-lame',
        'schivata-mirabile',
        'nube-accecante',
        'fulmine',
        'preghiera-di-gruppo',
        'colonna-di-luce',
        'doppio-tiro',
        'trappola-a-molla',
        'marcia-di-guerra',
        'risata-folle'
        // scelte:poteri5:fine
      ];
    }
    function poteriEroe7() {
      return [
        // scelte:poteri7
        'raffica-d-acciaio',
        'baluardo',
        'colpo-mortale',
        'veleno-paralizzante',
        'tempesta-di-fuoco',
        'parola-di-stasi',
        'purificazione',
        'martello-sacro',
        'freccia-perforante',
        'balsamo-del-bosco',
        'inno-del-trionfo',
        'tempesta-di-note'
        // scelte:poteri7:fine
      ];
    }
    function poteriEroe9() {
      return [
        // scelte:poteri9
        'furia-del-campione',
        'ultimo-baluardo',
        'mille-tagli',
        'ombra-vivente',
        'pioggia-di-meteore',
        'veste-di-brina',
        'rialzati',
        'ira-divina',
        'raffica-del-cacciatore',
        'freccia-uccisore',
        'canzone-della-rinascita',
        'finale-magistrale'
        // scelte:poteri9:fine
      ];
    }
    function sceltaOk(s, k, liv, ids) { return !(k in s) || (s[k] in ids && int(k) <= liv); }
    function scelteEroeOk(d) {
      return !('scelte' in d) || (d.scelte is map && d.scelte.keys().hasOnly(['2', '3', '4', '5', '6', '7', '8', '9', '10'])
        && sceltaOk(d.scelte, '2', d.liv, talentiEroe()) && sceltaOk(d.scelte, '4', d.liv, talentiEroe()) && sceltaOk(d.scelte, '6', d.liv, talentiEroe())
        && sceltaOk(d.scelte, '8', d.liv, talentiEroe()) && sceltaOk(d.scelte, '10', d.liv, talentiEroe())
        && sceltaOk(d.scelte, '3', d.liv, poteriEroe3()) && sceltaOk(d.scelte, '5', d.liv, poteriEroe5())
        && sceltaOk(d.scelte, '7', d.liv, poteriEroe7()) && sceltaOk(d.scelte, '9', d.liv, poteriEroe9()));
    }
    function postoEroeOk(q, k, ids) { return q.get(k, null) == null || q.get(k, null) in ids; }
    function equipEroeOk(q) {
      return q is map && q.keys().hasOnly(['arma', 'scudo', 'armatura', 'acc1', 'acc2'])
        && postoEroeOk(q, 'arma', armiEroe()) && postoEroeOk(q, 'scudo', scudiEroe()) && postoEroeOk(q, 'armatura', armatureEroe())
        && postoEroeOk(q, 'acc1', accessoriEroe()) && postoEroeOk(q, 'acc2', accessoriEroe());
    }
    function zainoEroeOk(d) {
      return (!('zaino' in d) || (d.zaino is list && d.zaino.size() <= 16 && d.zaino.hasOnly(oggettiEroe())))
        && (!('cintura' in d) || (d.cintura is list && d.cintura.size() <= 3 && d.cintura.hasOnly(consumabiliEroe())));
    }
    // Crescita limitata (nessuna Cloud Function: è una protezione leggera contro chi modifica il client). A ogni scrittura
    // l'esperienza sale di al massimo 800 e l'oro di 1000; chi guadagna scrive anche `agg` (ora del server) e deve
    // aspettare 60 secondi dall'ultimo guadagno. Spendere oro o curarsi non ha attesa. Stessi numeri di EROI.LIMITI.
    function guadagnoOk(n, v) {
      return n.xp - v.xp <= 800 && n.oro - v.oro <= 1000
        && ((n.xp == v.xp && n.oro <= v.oro && n.get('agg', null) == v.get('agg', null))
          || (n.agg == request.time && request.time > v.get('agg', timestamp.value(0)) + duration.value(60, 's')));
    }
    function eroeOk(d) {
      return d.keys().hasOnly(['v', 'nome', 'razza', 'classe', 'aspetto', 'base', 'liv', 'xp', 'oro', 'equip', 'zaino', 'cintura', 'scelte', 'creato', 'hpMax', 'hp', 'agg'])
        && (!('agg' in d) || d.agg is timestamp)
        && d.v == 1 && d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 16
        && razzaEroeOk(d.razza) && classeEroeOk(d.classe) && baseEroeOk(d.base) && aspettoEroeOk(d.aspetto)
        && d.liv is int && d.liv >= 1 && d.liv <= 10 && d.xp is int && d.xp >= 0 && d.xp < 100000
        && d.oro is int && d.oro >= 0 && d.oro < 1000000
        && d.hpMax is int && d.hpMax >= 1 && d.hpMax <= 200 && d.hp is int && d.hp >= 0 && d.hp <= d.hpMax
        && equipEroeOk(d.equip) && zainoEroeOk(d) && scelteEroeOk(d) && d.creato is int;
    }

    match /players/{uid}/eroi/{eroe} {
      allow read: if accesso() && request.auth.uid == uid;
      allow create: if accesso() && request.auth.uid == uid && eroe in ['e1', 'e2', 'e3', 'e4', 'e5']
        && eroeOk(request.resource.data) && !('agg' in request.resource.data) && request.resource.data.liv == 1 && request.resource.data.xp == 0 && request.resource.data.oro == 20;
      allow update: if accesso() && request.auth.uid == uid && eroeOk(request.resource.data)
        && request.resource.data.razza == resource.data.razza && request.resource.data.classe == resource.data.classe
        && request.resource.data.base == resource.data.base && request.resource.data.aspetto == resource.data.aspetto
        && request.resource.data.creato == resource.data.creato
        && request.resource.data.liv >= resource.data.liv && request.resource.data.xp >= resource.data.xp
        && guadagnoOk(request.resource.data, resource.data);
      allow delete: if accesso() && request.auth.uid == uid;
    }

    match /players/{uid} {
      // il nome e le monete servono agli altri (classifiche, tavolo): lettura per chi ha fatto l'accesso
      allow read: if accesso();

      // creazione: solo il proprio profilo, vuoto
      allow create: if accesso() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'coins', 'played', 'wins', 'owned', 'equipped', 'createdAt', 'lastAward'])
        && nomeOk(request.resource.data)
        && request.resource.data.coins == 0
        && request.resource.data.played == 0
        && request.resource.data.wins == 0
        && request.resource.data.createdAt == request.time;

      // aggiornamento: solo il proprio profilo e solo i campi previsti
      allow update: if accesso() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'coins', 'played', 'wins', 'owned', 'equipped', 'lastAward', 'elo'])
        && nomeOk(request.resource.data)
        && (
          // 1) niente monete e niente oggetti nuovi: cambio di nome o scelta dei cosmetici già posseduti
          (request.resource.data.coins == resource.data.coins
            && request.resource.data.played == resource.data.played
            && request.resource.data.wins == resource.data.wins
            && request.resource.data.owned == resource.data.owned
            && eloUguale())
          // 2) premio di fine partita: da 1 a 30 monete, una partita in più, al massimo una vittoria in più,
          //    non più spesso di una volta ogni 50 secondi; può spostare di poco la valutazione ELO di UN gioco
          || (request.resource.data.coins > resource.data.coins
              && request.resource.data.coins - resource.data.coins <= 30
              && request.resource.data.played == resource.data.played + 1
              && request.resource.data.wins >= resource.data.wins
              && request.resource.data.wins <= resource.data.wins + 1
              && request.resource.data.owned == resource.data.owned
              && (eloUguale() || (
                // elo:inizio
                elo('regicide')
                || elo('briscola')
                || elo('scopa')
                || elo('burraco')
                || elo('gang')
                || elo('island')
                || elo('mind')
                || elo('mindx')
                || elo('harvest')
                || elo('valle')
                || elo('accordi')
                || elo('discesa')
                || elo('perudo')
                || elo('kittens')
                || elo('catan')
                || elo('pets')
                || elo('uno')
                || elo('spie')
                || elo('quiz')
                || elo('zucca')
                || elo('fantasma')
                || elo('trono')
                || elo('giallo')
                || elo('scoundrel')
                || elo('machiavelli')
                || elo('azul')
                || elo('saboteur')
                || elo('regix')
                || elo('rlegacy')
                // elo:fine
              ))
              && request.resource.data.lastAward == request.time
              && (resource.data.lastAward == null || request.time > resource.data.lastAward + duration.value(50, 's')))
          // 3) acquisto dalla bottega al prezzo del catalogo (le righe tra i segnaposto sono generate: npm run regole)
          || (request.resource.data.coins >= 0
              && eloUguale()
              && request.resource.data.played == resource.data.played
              && request.resource.data.wins == resource.data.wins
              && (
                // bottega:inizio
                acquisto('dorso-notte', 40)
                || acquisto('dorso-bosco', 60)
                || acquisto('dorso-brace', 80)
                || acquisto('dorso-corvo', 100)
                || acquisto('dorso-brina', 120)
                || acquisto('dorso-oro', 160)
                // bottega:fine
              ))
        );

      allow delete: if false;
    }

    // partite a distanza: stanze che restano salvate (stato come testo `j`, campi leggibili per l'elenco).
    // Si entra conoscendo il codice (8 caratteri): chi entra aggiunge solo il proprio uid a `uids`; dopo, scrive solo chi è dentro.
    match /partite/{code} {
      function campi(d) { return d.keys().hasOnly(['j', 'uids', 'host', 'phase', 'game', 'turno', 'nomi', 'finita', 'rev', 'upd']); }
      function dentro() { return request.auth.uid in get(/databases/$(database)/documents/partite/$(code)).data.uids; }

      allow read: if accesso();

      allow create: if accesso() && campi(request.resource.data)
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.host == request.auth.uid
        && request.resource.data.j is string && request.resource.data.j.size() < 900000;

      allow update: if accesso() && campi(request.resource.data)
        && request.resource.data.host == resource.data.host
        && request.resource.data.uids.hasAll(resource.data.uids)
        && request.resource.data.uids.size() <= 8
        && request.resource.data.j is string && request.resource.data.j.size() < 900000
        && (request.auth.uid in resource.data.uids
            // entrare: cambia solo l'elenco, aggiungendo se stessi
            || (request.auth.uid in request.resource.data.uids
                && request.resource.data.uids.size() == resource.data.uids.size() + 1
                && request.resource.data.j == resource.data.j));

      allow delete: if accesso() && resource.data.host == request.auth.uid;

      match /membri/{m} {
        allow read: if accesso();
        allow create, update: if accesso() && m == ('u:' + request.auth.uid) && dentro();
        allow delete: if accesso() && dentro();
      }
      match /chat/{c} {
        allow read: if accesso();
        allow create, delete: if accesso() && dentro();
      }
    }

    // tutto il resto è chiuso finché non lo apriamo con una regola esplicita
    match /{altro=**} {
      allow read, write: if false;
    }
  }
}
