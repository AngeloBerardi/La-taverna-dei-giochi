{
  "rules": {
    ".read": false,
    ".write": false,
    "errori": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['t', 'm']) && newData.child('t').isNumber() && newData.child('m').isString() && newData.child('m').val().length <= 200 && (!newData.hasChild('s') || newData.child('s').val().length <= 300)"
      }
    },
    "stanze": {
      "$code": {
        ".read": "auth != null",
        "d": {
          ".write": "auth != null && newData.exists() && (!data.exists() || root.child('stanze').child($code).child('k').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['j', 'rev']) && newData.child('j').isString() && newData.child('j').val().length <= 900000 && newData.child('rev').isNumber() && (!data.exists() || newData.child('rev').val() > data.child('rev').val())"
        },
        "dv": {
          "$dev": {
            ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
            ".validate": "$dev.matches(/^[\\w:-]{1,64}$/) && newData.isString()"
          }
        },
        "k": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "m": {
          "$dev": {
            ".write": "auth != null && ((newData.exists() && root.child('stanze').child($code).child('dv').child($dev).val() === auth.uid) || (!newData.exists() && (root.child('stanze').child($code).child('dv').child($dev).val() === auth.uid || root.child('stanze').child($code).child('k').child(auth.uid).exists())))",
            ".validate": "newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 20000"
          }
        },
        "c": {
          "$id": {
            ".write": "auth != null && root.child('stanze').child($code).child('k').child(auth.uid).exists()",
            ".validate": "newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 4000"
          }
        },
        "pos": {
          "$dev": {
            ".write": "auth != null && root.child('stanze').child($code).child('dv').child($dev).val() === auth.uid",
            ".validate": "newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 400"
          }
        },
        "p": {
          "$dev": {
            ".write": "auth != null && root.child('stanze').child($code).child('dv').child($dev).val() === auth.uid",
            ".validate": "newData.hasChild('t')"
          }
        },
        "r": {
          ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && root.child('stanze').child($code).child('k').child(auth.uid).exists()) || (!newData.exists() && (data.val() === auth.uid || root.child('stanze').child($code).child('k').child(auth.uid).exists())))",
          ".validate": "newData.isString() && newData.val().length <= 128"
        }
      }
    },
    "regia": {
      "$code": {
        ".read": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        ".write": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        ".validate": "$code.matches(/^[\\w-]{1,16}$/) && newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 900000"
      }
    },
    "segreti": {
      "$code": {
        ".read": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        ".write": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$k": {
            ".validate": "$k.matches(/^[\\w-]{1,32}$/) && newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 60000"
          }
        }
      }
    },
    "azioni": {
      "$code": {
        ".read": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        ".write": "auth != null && root.child('stanze').child($code).child('r').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('stanze').child($code).child('k').child(auth.uid).exists()",
          "$id": {
            ".validate": "$id.matches(/^[\\w-]{1,40}$/) && newData.hasChild('j') && newData.child('j').isString() && newData.child('j').val().length <= 4000"
          }
        }
      }
    },
    "viaggi": {
      "$k": {
        ".read": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/)",
        "proposte": {
          "$g": {
            "$id": {
              ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/) && $g.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))",
              ".validate": "newData.hasChildren(['autore','titolo','t','uid'])",
              "autore": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,20}$/)"
              },
              "titolo": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "nota": {
                ".validate": "newData.isString() && newData.val().length <= 600"
              },
              "luogo": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "link": {
                ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\//)"
              },
              "fascia": {
                ".validate": "newData.isString() && newData.val().matches(/^(mattina|pomeriggio|sera)$/)"
              },
              "lat": {
                ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
              },
              "lng": {
                ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
              },
              "voti": {
                "$nome": {
                  ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/)",
                  ".validate": "newData.val() === true && $nome.matches(/^[A-Za-z]{2,20}$/)"
                }
              },
              "ok": {
                ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/)",
                ".validate": "newData.isBoolean()"
              },
              "ora": {
                ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/)",
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "idea": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,80}$/)"
              },
              "$altro": {
                ".validate": "false"
              }
            }
          }
        },
        "reazioni": {
          "$i": {
            "$nome": {
              ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/) && $i.matches(/^[A-Za-z0-9_-]{1,80}$/)",
              ".validate": "$nome.matches(/^[A-Za-z]{2,20}$/) && (newData.val() === 1 || newData.val() === -1)"
            }
          }
        },
        "commenti": {
          "$i": {
            "$c": {
              ".write": "auth != null && $k.length >= 20 && $k.length <= 64 && $k.matches(/^[A-Za-z0-9]+$/) && $i.matches(/^[A-Za-z0-9_-]{1,80}$/) && $c.matches(/^[A-Za-z0-9_-]{1,40}$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
              ".validate": "newData.hasChildren(['autore','testo','t','uid'])",
              "autore": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,20}$/)"
              },
              "testo": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "$altro": {
                ".validate": "false"
              }
            }
          }
        },
        "$altro": {
          ".validate": "false"
        }
      }
    }
  }
}
