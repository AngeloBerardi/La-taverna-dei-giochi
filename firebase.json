{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.DS_Store", "**/node_modules/**", "**/*.apk"],
    "redirects": [
      { "source": "/taverna.apk", "destination": "https://github.com/AngeloBerardi/La-taverna-dei-giochi/releases/download/android/taverna.apk", "type": 302 }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      { "source": "/vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" }
}
